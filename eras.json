[{"id":"universal-monsters","title":"1930s–1950s: Universal Monsters","startYear":1930,"endYear":1959,"thematicFocus":"Gothic escapism, romanticized monsters, external threats, nuclear anxiety.","culturalContext":"Born during the Great Depression and World War II, horror allowed audiences to project real-world anxieties onto fantastical creatures. Later, Cold War nuclear fears manifested in giant monster cinema.","subgenres":[{"category":"Classic Gothic & Romantic Monsters","movies":[{"id":138,"title":"Dracula","year":"1931"},{"id":3035,"title":"Frankenstein","year":"1931"},{"id":1678,"title":"The Mummy","year":"1932"},{"id":11319,"title":"The Invisible Man","year":"1933"},{"id":158,"title":"The Bride of Frankenstein","year":"1935"},{"id":11984,"title":"The Wolf Man","year":"1941"},{"id":13915,"title":"Cat People","year":"1942"},{"id":11356,"title":"House on Haunted Hill","year":"1959"}]},{"category":"Atomic Age & Creature Features","movies":[{"id":10972,"title":"Creature from the Black Lagoon","year":"1954"},{"id":1678,"title":"Godzilla","year":"1954"},{"id":16127,"title":"Them!","year":"1954"},{"id":11843,"title":"Invasion of the Body Snatchers","year":"1956"},{"id":11357,"title":"The Fly","year":"1958"},{"id":27289,"title":"The Blob","year":"1958"}]}]},{"id":"psychological-shift","title":"1960s–1970s: Psychological Shift","startYear":1960,"endYear":1979,"thematicFocus":"Real-world violence, domestic terror, loss of institutional trust, female autonomy.","culturalContext":"Civil rights unrest, the Vietnam War, and the decay of the nuclear family shifted horror into domestic spaces. Monsters became human neighbors, masked killers, or bodily threats.","subgenres":[{"category":"Domestic & Psychological Terror","movies":[{"id":539,"title":"Psycho","year":"1960"},{"id":11902,"title":"Peeping Tom","year":"1960"},{"id":782,"title":"The Birds","year":"1963"},{"id":10331,"title":"Night of the Living Dead","year":"1968"},{"id":8077,"title":"Rosemary's Baby","year":"1968"},{